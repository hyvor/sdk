{
    "name": "hyvor/sdk-talk",
    "description": "Official PHP SDK for Hyvor Talk",
    "type": "library",
    "license": "MIT",
    "version": "0.1.0",
    "require": {
        "php": ">=8.4",
        "hyvor/sdk-core": "^0.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "nyholm/psr7": "^1.8",
        "phpstan/phpstan": "^2.2",
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../core"
        }
    ],
    "autoload": {
        "psr-4": {
            "Hyvor\\Sdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hyvor\\Sdk\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
