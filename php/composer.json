{
    "name": "hyvor/sdk-dev",
    "description": "Dev-only aggregator for the hyvor/sdk-* PHP packages. Not published - installs packages/{core,talk,post} from disk via path repositories so the whole monorepo can be tested in one command.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "hyvor/sdk-core": "*",
        "hyvor/sdk-talk": "*",
        "hyvor/sdk-post": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "nyholm/psr7": "^1.8",
        "guzzlehttp/guzzle": "^7.15",
        "phpstan/phpstan": "^2.2",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/core"
        },
        {
            "type": "path",
            "url": "packages/talk"
        },
        {
            "type": "path",
            "url": "packages/post"
        }
    ],
    "autoload-dev": {
        "psr-4": {
            "Hyvor\\Sdk\\Tests\\": [
                "packages/core/tests/",
                "packages/talk/tests/",
                "packages/post/tests/",
                "tests/"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
