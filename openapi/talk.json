{
  "openapi": "3.0.0",
  "info": {
    "title": "Hyvor Talk",
    "description": "Privacy-first Commenting Platform",
    "version": "1.0.0"
  },
  "paths": {
    "/api/console/v1/{websiteId}/domains": {
      "post": {
        "tags": [
          "method:update",
          "group:domains"
        ],
        "operationId": "post_api_console_app_api_console_domains_update",
        "parameters": [
          {
            "name": "websiteId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "\\d+"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateDomainsInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Returns the updated list of domains for the website.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DomainObject"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/console/v1/{websiteId}/mods": {
      "post": {
        "tags": [
          "method:create",
          "group:mods"
        ],
        "operationId": "post_api_console_app_api_console_mods_create",
        "parameters": [
          {
            "name": "websiteId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "\\d+"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateModInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Returns the created moderator object.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModObject"
                }
              }
            }
          },
          "200": {
            "description": "Returns the existing moderator object, if `on_duplicate` is `ignore` and the user is already a moderator.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModObject"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "method:delete",
          "group:mods"
        ],
        "operationId": "delete_api_console_app_api_console_mods_delete",
        "parameters": [
          {
            "name": "websiteId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "\\d+"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeleteModInput"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Returns an empty object on successful deletion.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/console/v1/websites": {
      "post": {
        "tags": [
          "method:create",
          "group:websites"
        ],
        "operationId": "post_api_console_app_api_console_org_websites_create",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateWebsiteInput"
              }
            }
          }
        },
        "responses": {
          "default": {
            "description": ""
          }
        }
      }
    },
    "/api/console/v1/{websiteId}/website": {
      "delete": {
        "tags": [
          "method:delete",
          "group:website"
        ],
        "operationId": "delete_api_console_app_api_console_website_delete",
        "parameters": [
          {
            "name": "websiteId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "\\d+"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Returns an empty object on successful deletion.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UpdateDomainsInput": {
        "properties": {
          "domains": {
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            ],
            "default": []
          },
          "operation": {
            "type": "string",
            "default": "add",
            "enum": [
              "add",
              "set"
            ]
          }
        },
        "type": "object"
      },
      "CreateModInput": {
        "required": [
          "user_id"
        ],
        "properties": {
          "user_id": {
            "type": "integer",
            "minimum": 0,
            "exclusiveMinimum": true
          },
          "role": {
            "type": "string",
            "default": "mod",
            "enum": [
              "mod",
              "admin"
            ]
          },
          "on_duplicate": {
            "type": "string",
            "default": "throw",
            "enum": [
              "throw",
              "ignore"
            ]
          }
        },
        "type": "object"
      },
      "DeleteModInput": {
        "properties": {
          "user_id": {
            "type": "integer",
            "nullable": true,
            "minimum": 0,
            "exclusiveMinimum": true
          },
          "mod_id": {
            "type": "integer",
            "nullable": true,
            "minimum": 0,
            "exclusiveMinimum": true
          }
        },
        "type": "object"
      },
      "CreateWebsiteInput": {
        "required": [
          "name",
          "domain"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 60
          },
          "domain": {
            "type": "string"
          },
          "metadata": {
            "type": "object",
            "default": [],
            "additionalProperties": {
              "nullable": true
            }
          },
          "start_trial": {
            "type": "boolean",
            "default": true
          },
          "owner_user_id": {
            "type": "integer",
            "nullable": true,
            "minimum": 0,
            "exclusiveMinimum": true
          }
        },
        "type": "object"
      },
      "DomainObject": {
        "required": [
          "id",
          "domain"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "domain": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "AuthUser": {
        "required": [
          "id",
          "username",
          "name",
          "email"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "username": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "picture_url": {
            "type": "string",
            "nullable": true,
            "default": null
          },
          "location": {
            "type": "string",
            "nullable": true,
            "default": null
          },
          "bio": {
            "type": "string",
            "nullable": true,
            "default": null
          },
          "website_url": {
            "type": "string",
            "nullable": true,
            "default": null
          },
          "oidc_sub": {
            "type": "string",
            "nullable": true,
            "default": null
          }
        },
        "type": "object"
      },
      "ModObject": {
        "required": [
          "id",
          "created_at",
          "role",
          "website_id",
          "user"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "created_at": {
            "type": "integer"
          },
          "role": {
            "type": "string"
          },
          "website_id": {
            "type": "integer"
          },
          "user": {
            "$ref": "#/components/schemas/AuthUser"
          }
        },
        "type": "object"
      }
    }
  },
  "tags": [
    {
      "name": "method:update",
      "description": "method:update"
    },
    {
      "name": "group:domains",
      "description": "group:domains"
    },
    {
      "name": "method:create",
      "description": "method:create"
    },
    {
      "name": "group:mods",
      "description": "group:mods"
    },
    {
      "name": "method:delete",
      "description": "method:delete"
    },
    {
      "name": "group:websites",
      "description": "group:websites"
    },
    {
      "name": "group:website",
      "description": "group:website"
    }
  ]
}